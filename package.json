{
  "name": "deucalint",
  "version": "0.1.0",
  "private": true,
  "description": "DeucalInt — Real-Time Behavioral Intelligence & Product Observability Platform",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/sdk.test.mjs",
    "test:e2e": "playwright test",
    "sdk:build": "esbuild packages/web-sdk/src/index.ts --bundle --format=esm --outfile=dist/sdk.js --minify",
    "check": "npm run build && npm run sdk:build && npm test",
    "format": "prettier --write \"apps/**/*.{ts,html,css,java}\" \"packages/**/*.{ts,mjs,java,json}\" \"tests/**/*.{ts,mjs}\" \"*.{json,ts,yml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,html,css,java}\" \"packages/**/*.{ts,mjs,java,json}\" \"tests/**/*.{ts,mjs}\" \"*.{json,ts,yml}\""
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "rxjs": "^7.8.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.9",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  },
  "type": "module"
}
