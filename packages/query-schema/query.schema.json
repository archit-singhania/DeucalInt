{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeucalInt safe segment AST",
  "oneOf": [
    {
      "type": "object",
      "properties": { "and": { "type": "array", "maxItems": 10, "items": { "$ref": "#" } } },
      "required": ["and"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "dimension": {
          "enum": ["browser", "device", "country", "release", "path", "name", "variant"]
        },
        "operator": { "enum": ["eq", "neq", "in"] },
        "value": { "type": ["string", "array"] }
      },
      "required": ["dimension", "operator", "value"],
      "additionalProperties": false
    }
  ]
}
